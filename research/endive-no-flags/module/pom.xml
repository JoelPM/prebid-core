<!-- Compiles one guest .wasm at build time with Endive's compiler plugin: JVM bytecode (always) plus
     Redline native code for aarch64-apple-darwin and x86_64-unknown-linux-gnu. Usage:
     mvn -q package -Dwasm=/abs/guest.wasm -Dmodname=bench.Guest -DbuildDir=/abs/out/dir -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>x</groupId><artifactId>guest-module</artifactId><version>1</version>
  <properties>
    <endive.version>1.1.0</endive.version>
    <maven.compiler.release>25</maven.compiler.release>
    <buildDir>${project.basedir}/target</buildDir>
  </properties>
  <dependencies>
    <dependency><groupId>run.endive</groupId><artifactId>runtime</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>compiler</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>redline-runner-experimental</artifactId><version>${endive.version}</version></dependency>
  </dependencies>
  <build>
    <directory>${buildDir}</directory>
    <plugins>
      <plugin>
        <groupId>run.endive</groupId>
        <artifactId>endive-compiler-maven-plugin</artifactId>
        <version>${endive.version}</version>
        <executions><execution><goals><goal>compile</goal></goals>
          <configuration>
            <name>${modname}</name>
            <wasmFile>${wasm}</wasmFile>
            <methodPrefixer>run.endive.compiler.NameSectionMethodPrefixer</methodPrefixer>
            <redlineTargetsExperimental>
              <target>aarch64-apple-darwin</target>
              <target>x86_64-unknown-linux-gnu</target>
            </redlineTargetsExperimental>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
